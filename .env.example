# Gain Email API base URL
GAIN_API_BASE_URL=http://emails-api.northeurope.cloudapp.azure.com:8009

# From address for all outgoing replies
GAIN_FROM_ADDRESS=natalie@somecompany.com

# Path to local JSON storage file (relative to project root or absolute)
GAIN_STORAGE_PATH=./data/emails.json

# Azure OpenAI credentials
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
